# Entornos virtuales de Python
venv/
env/
.venv/

# Archivos compilados de Python
__pycache__/
*.py[cod]
*$py.class

# Base de datos local (NO subir datos de usuarios reales/pruebas)
*.sqlite3
*.db
app.db

# Variables de entorno y secretos (IMPORTANTE)
.env
.env.local
.env.*
!.env.example

# Frontend (React/Vite/Node)
frontend/node_modules/
frontend/dist/
frontend/.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos del sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
