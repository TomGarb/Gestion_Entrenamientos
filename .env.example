# ==============================================================================
# GYMTRACKER BACKEND - VARIABLES DE ENTORNO (.env.example)
# ==============================================================================

# 1. BASE DE DATOS (Neon PostgreSQL en Producción / SQLite en Local)
# Producción: postgresql://usuario:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:tu_password_aqui@ep-cool-forest-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. SEGURIDAD & AUTENTICACIÓN (JWT)
# Generar una clave segura aleatoria de 32+ caracteres (ej: openssl rand -hex 32)
SECRET_KEY=clave_secreta_super_segura_de_produccion_generada_aleatoriamente_32chars

# 3. ENLACE DE FRONTEND & CORS (Vercel)
# URL de la aplicación React alojada en Vercel (permite múltiples separadas por coma)
FRONTEND_URL=https://gym-tracker-app-murex.vercel.app,http://localhost:5173

# 4. BOT DE TELEGRAM (Notificaciones y Asistente Express)
# Token obtenido desde @BotFather en Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# 5. GOOGLE AUTH (Opcional - para inicio de sesión con Google)
# ID de cliente obtenido de Google Cloud Console
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
